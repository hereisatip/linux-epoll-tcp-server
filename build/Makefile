# target to preprocess a source file
tests/socket_utils_test.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/socket_utils_test.dir/build.make CMakeFiles/socket_utils_test.dir/tests/socket_utils_test.cpp.i
.PHONY : tests/socket_utils_test.cpp.i

