{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: g++ 生成活动文件",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-I${workspaceFolder}/include",
                "${workspaceFolder}/src/protocol.cpp",
                "${workspaceFolder}/tests/protocol_test.cpp",
                "-o",
                "${workspaceFolder}/build/protocol_test"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}